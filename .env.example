# ─────────────────────────────────────────────────────────────
#  LF Live — .env
#  Copy to ".env". Everything is optional; lf_live runs with no
#  .env and is then configured entirely from the web console.
#
#  A value set here is PINNED: the console shows it read-only.
#  Use .env for ports/binds/secrets, the console for match-day settings.
#  Full reference: docs/CONFIG.md   ·   Security: docs/SECURITY.md
# ─────────────────────────────────────────────────────────────

# ── Web console + JSON/WebSocket API ──────────────────────────
LF_HTTP_HOST=0.0.0.0          # 0.0.0.0 = reachable from the hall LAN · 127.0.0.1 = this PC only
LF_HTTP_PORT=8080

LF_API_TOKEN=                 # for MACHINES (overlays, scripts): set = Bearer token accepted instead of a login
LF_CORS_ORIGINS=              # browser origins allowed to call the read API (comma list) · empty = none · * = any GET
LF_RATE_LIMIT_PER_MIN=600     # per-IP request cap on the HTTP API · 0 = off
LF_STATE_TICK_MS=200          # shared state-push cadence for WS / raw stream / outputs (ms) · min 50 · max 5000
LF_TRUST_PROXY=false          # true = take the client IP from X-Forwarded-For · only behind your own reverse proxy

# ── Admin login for the console (docs/SECURITY.md) ───────────
# The console is never open. Leave this commented out and, on the FIRST start:
#   · with a notification channel below -> a password is generated and sent there
#   · without one                       -> the console serves /setup, you pick it
#                                          in the browser; nothing else works yet
# Either way you need no monitor and no shell on the hall PC.
#LF_ADMIN_PASSWORD=           # set here = fixed, the console cannot change it
#LF_ADMIN_PASSWORD_HASH=      # alternative: paste a scrypt$… hash instead of the plaintext
LF_ADMIN_ENABLED=true         # false = NO login at all — only on a closed bench network
LF_ADMIN_SESSION_HOURS=12     # how long a login lasts before the browser must log in again

# ── "Which IP and port am I on?" (docs/NOTIFY.md) ────────────
# Sent once at every start (and when the IP changes) so you know how to reach
# the box without a monitor. The FIRST start also carries the admin password;
# every later one only the address. Same channel delivers the "forgot password"
# code. Pick ONE line — or several. All of this can also be set in the console
# under Einstellungen -> Start-Benachrichtigung.
LF_NOTIFY_ENABLED=true
LF_NOTIFY_NAME=lf_bridge               # name of this installation in the message · empty = hostname
LF_NOTIFY_ON_START=true
LF_NOTIFY_ON_IP_CHANGE=true

#LF_NOTIFY_NTFY_TOPIC=lf-live-halle1          # simplest: install the ntfy app, subscribe to this topic
#LF_NOTIFY_NTFY_SERVER=https://ntfy.sh        # own ntfy server? put it here
#LF_NOTIFY_NTFY_TOKEN=                        # only for a protected ntfy server

#LF_NOTIFY_DISCORD_WEBHOOK=                   # channel → Settings → Integrations → Webhooks → Copy URL
#LF_NOTIFY_SLACK_WEBHOOK=                     # Slack incoming webhook URL

#LF_NOTIFY_TELEGRAM_TOKEN=                    # from @BotFather
#LF_NOTIFY_TELEGRAM_CHAT_ID=                  # your chat/group id

#LF_NOTIFY_WEBHOOK_URL=                       # your own endpoint, gets the whole thing as JSON
#LF_NOTIFY_WEBHOOK_SECRET=                    # optional → HMAC in X-LFB-Signature

#LF_NOTIFY_EMAIL_TO=technik@beispiel.de       # e-mail: recipient …
#LF_NOTIFY_SMTP_HOST=smtp.beispiel.de         # … and the mailbox it is sent from
#LF_NOTIFY_SMTP_PORT=587                      # 587 = STARTTLS · 465 = implicit TLS (then SECURE=true)
#LF_NOTIFY_SMTP_SECURE=false
#LF_NOTIFY_SMTP_USER=
#LF_NOTIFY_SMTP_PASS=
#LF_NOTIFY_SMTP_FROM=lf-live@beispiel.de

#LF_NOTIFY_INCLUDE_INITIAL_PASSWORD=true      # false = only name the file it is stored in, not the password

# ── Laserforce log stream comes IN here ──────────────────────
LF_TCP_HOST=0.0.0.0
LF_TCP_PORT=9000

# ── Raw newline-delimited-JSON stream goes OUT here ──────────
# Tools connect in and receive the same messages as /ws. Off by default,
# binds to localhost unless you widen the host.
# With LF_API_TOKEN set, a client must send {"token":"…"}\n as its first line.
LF_STREAM_ENABLED=false
LF_STREAM_HOST=127.0.0.1
LF_STREAM_PORT=9100

# ── Where outputs may push to ─────────────────────────────────
# Comma list of allowed targets: "host", "host:port", "*.suffix" · empty = any
LF_OUTPUT_ALLOW=

# ── Statistics → CSV files on this PC (docs/STATS.md) ────────
# Written per game-mode family (all_players_laserball.csv / _sm5.csv, totals_*),
# plus matches.csv and player_modes.csv. No extra settings for that — automatic.
LF_CSV_ENABLED=true
LF_CSV_DIR=data/stats
LF_CSV_DELIMITER=;            # ";" German Excel · "," pandas · tab
LF_CSV_BOM=true               # BOM so Excel shows umlauts correctly
LF_CSV_EVENTS=true            # also write a per-match event log
LF_CSV_LIVE=false             # update the match CSV during the match, not just at the end

# ── Human-readable event-log file (docs/LOGGING.md) ─────────
LF_EVENTLOG_ENABLED=true      # append one readable line per event to data/logs/
LF_EVENTLOG_DIR=data/logs     # target folder (relative to the program)
LF_EVENTLOG_ROTATE=daily      # daily = events-YYYY-MM-DD.log · match = events-<matchId>.log · none = events.log

# ── Match engine ────────────────────────────────────────────
LF_EMIT_UNKNOWN_EVENTS=true   # also emit a generic lf_event for every type-4 code the parser doesn't act on

# ── Optional self-maintained name list (CSV: id,name,team) ───
LF_LOCAL_ROSTER_ENABLED=false
LF_LOCAL_ROSTER_FILE=data/roster.csv

# ── Misc ─────────────────────────────────────────────────────
LF_MATCH_DURATION_MS=720000   # placeholder until Laserforce reports a duration (TDF type 1).
                              # NOT shown as a countdown: without a reported duration the
                              # clock counts UP instead (docs/GAMEMODES.md).
LF_LOG_LEVEL=info             # debug | info | warn | error
LF_CONFIG_FILE=config.json    # where the console-editable config lives
