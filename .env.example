# ─────────────────────────────────────────────────────────────
#  LF Live — .env
#  Copy to ".env". Everything is optional; lf_live runs with no
#  .env and is then configured entirely from the web console.
#
#  A value set here is PINNED: the console shows it read-only.
#  Use .env for ports/binds/secrets, the console for match-day settings.
#  Full reference: docs/CONFIG.md   ·   Security: docs/SECURITY.md
# ─────────────────────────────────────────────────────────────

# ── Web console + JSON/WebSocket API ──────────────────────────
LF_HTTP_HOST=0.0.0.0          # 0.0.0.0 = reachable from the hall LAN · 127.0.0.1 = this PC only
LF_HTTP_PORT=8080

LF_API_TOKEN=                 # empty = open on the LAN · set = Bearer token required (recommended off a trusted net)
LF_CORS_ORIGINS=              # browser origins allowed to call the read API (comma list) · empty = none · * = any GET
LF_RATE_LIMIT_PER_MIN=600     # per-IP request cap on the HTTP API · 0 = off
LF_STATE_TICK_MS=200          # shared state-push cadence for WS / raw stream / outputs (ms) · min 50 · max 5000
LF_TRUST_PROXY=false          # true = take the client IP from X-Forwarded-For · only behind your own reverse proxy

# ── Laserforce log stream comes IN here ──────────────────────
LF_TCP_HOST=0.0.0.0
LF_TCP_PORT=9000

# ── Raw newline-delimited-JSON stream goes OUT here ──────────
# Tools connect in and receive the same messages as /ws. Off by default,
# binds to localhost unless you widen the host.
# With LF_API_TOKEN set, a client must send {"token":"…"}\n as its first line.
LF_STREAM_ENABLED=false
LF_STREAM_HOST=127.0.0.1
LF_STREAM_PORT=9100

# ── Where outputs may push to ─────────────────────────────────
# Comma list of allowed targets: "host", "host:port", "*.suffix" · empty = any
LF_OUTPUT_ALLOW=

# ── Statistics → CSV files on this PC (docs/STATS.md) ────────
LF_CSV_ENABLED=true
LF_CSV_DIR=data/stats
LF_CSV_DELIMITER=;            # ";" German Excel · "," pandas · tab
LF_CSV_BOM=true               # BOM so Excel shows umlauts correctly
LF_CSV_EVENTS=true            # also write a per-match event log
LF_CSV_LIVE=false             # update the match CSV during the match, not just at the end

# ── Optional self-maintained name list (CSV: id,name,team) ───
LF_LOCAL_ROSTER_ENABLED=false
LF_LOCAL_ROSTER_FILE=data/roster.csv

# ── Misc ─────────────────────────────────────────────────────
LF_MATCH_DURATION_MS=720000   # fallback until Laserforce reports the real duration
LF_LOG_LEVEL=info             # debug | info | warn | error
LF_CONFIG_FILE=config.json    # where the console-editable config lives
