# ─────────────────────────────────────────────────────────────────────────────
#  LF Live — Vorlage für die .env
#
#  Kopieren:   cp .env.example .env      (Windows:  copy .env.example .env)
#
#  HIER STEHT JEDE EINSTELLUNG, DIE ES GIBT — vollständig, mit Vorgabewert.
#  Absichtlich ist ALLES auskommentiert: eine frisch kopierte .env ändert damit
#  nichts und pinnt nichts. Du nimmst genau die Zeilen wieder her, die du
#  wirklich festlegen willst.
#
#  ── Die drei Ebenen, die spätere gewinnt ───────────────────────────────────
#    1. eingebaute Vorgaben        (src/config.js)
#    2. config.json                 Match-Tag-Einstellungen, Web-Konsole
#    3. .env / Umgebung             gewinnt IMMER  →  „gepinnt"
#
#  GEPINNT heißt: eine hier gesetzte Zeile zeigt die Konsole nur noch lesbar an
#  und ein Speichern in der Konsole kann sie nicht überschreiben. Lass einen
#  Wert deshalb entweder nur hier ODER nur in der Konsole.
#
#  Ein leerer Wert (LF_API_TOKEN=) zählt bei den meisten Einstellungen als
#  „nicht gesetzt"; die Ausnahmen sind unten jeweils vermerkt.
#
#  Vollständige Tabelle:  docs/CONFIG.md   ·   Sicherheit:  docs/SECURITY.md
# ─────────────────────────────────────────────────────────────────────────────


# ═══ 1 · Wo liegt was, wie laut ist das Log ═════════════════════════════════

#LF_CONFIG_FILE=config.json
# Vorgabe: config.json im Arbeitsverzeichnis. Datei mit den Konsolen-Einstellungen.
# Anfassen: nur wenn mehrere Instanzen auf einem Rechner laufen sollen.

#LF_ENV_FILE=.env
# Vorgabe: .env im Arbeitsverzeichnis. Alternative Umgebungsdatei.
# Anfassen: nur wenn die .env woanders liegt (ein Dienstmanager gibt sie vor).

#LF_MODES_DIR=modes
# Vorgabe: der Ordner modes/ neben src/. Dort liegen die Spielmodus-Dateien.
# Anfassen: praktisch nie — nur beim Paketieren oder in Tests.

#LF_LOG_LEVEL=info
# Vorgabe: info. debug | info | warn | error.
# Anfassen: debug nur zur Fehlersuche, es schreibt eine Zeile je Logzeile der Anlage.


# ═══ 2 · Web-Konsole + JSON/WebSocket-API ══════════════════════════════════

#LF_HTTP_HOST=0.0.0.0
# Vorgabe: 0.0.0.0 — im ganzen Hallen-LAN erreichbar. 127.0.0.1 = nur dieser PC.
# Anfassen: wenn die Konsole nicht ins LAN soll (z. B. hinter einem Reverse-Proxy).

#LF_HTTP_PORT=8080
# Vorgabe: 8080. Port für Konsole, JSON-API und WebSocket zusammen.
# Anfassen: wenn 8080 auf dem Rechner schon belegt ist. Wirkt erst nach Neustart.

#LF_API_TOKEN=
# Vorgabe: leer = kein Token nötig. Gesetzt: Programme kommen mit
# `Authorization: Bearer <token>` bzw. `?token=` ohne Anmeldung an jede /api/*
# (außer /api/health), an den WebSocket und an den rohen TCP-Stream.
# Anfassen: sobald eine Anzeige, ein Overlay oder ein Skript die API abfragt.

#LF_CORS_ORIGINS=
# Vorgabe: leer = kein Browser von einer fremden Adresse darf die API lesen.
# Komma-Liste von Origins, `*` erlaubt beliebige (nur GET).
# Anfassen: wenn eine Weboberfläche auf einem ANDEREN Rechner/Port die API liest.
# Die Konsole selbst braucht keinen Eintrag (same-origin). Für curl irrelevant.

#LF_RATE_LIMIT_PER_MIN=600
# Vorgabe: 600 Anfragen je Minute und IP auf der HTTP-API. 0 = aus.
# Anfassen: nur wenn eine legitime Anzeige häufiger pollt als 10×/s.

#LF_TRUST_PROXY=false
# Vorgabe: false — die Client-IP kommt aus dem Socket.
# true nimmt sie aus dem linkesten X-Forwarded-For-Eintrag (Ratengrenze, Audit-Log).
# Anfassen: NUR wenn ein eigener Reverse-Proxy davorsteht — sonst ist der Header
# frei fälschbar und Ratengrenze wie Sperrliste sind wirkungslos.

#LF_STATE_TICK_MS=200
# Vorgabe: 200 ms Takt für den gemeinsamen Zustands-Push an WebSocket, rohen
# TCP-Stream und Ausgänge (min 50, max 5000). Ereignisse gehen davon unabhängig
# sofort raus.
# Anfassen: höher, wenn viele Konsolen offen sind und das Netz knapp wird
# (72 KB je Push und Konsole, siehe docs/PERFORMANCE.md). Wirkt erst nach Neustart.


# ═══ 3 · Admin-Login der Konsole (docs/SECURITY.md) ════════════════════════
#
# Die Konsole ist NIE offen. Lass die beiden Passwort-Zeilen aus und beim
# ERSTEN Start passiert eines von beidem:
#   · ein Benachrichtigungskanal (Abschnitt 15) ist eingerichtet → ein Passwort
#     wird erzeugt und geht dort raus
#   · kein Kanal → die Konsole zeigt /setup, du vergibst es im Browser
# Beides funktioniert ohne Monitor und ohne Shell am Hallen-PC.

#LF_ADMIN_ENABLED=true
# Vorgabe: true. false schaltet den Login GANZ ab — die Konsole ist dann für
# jeden im LAN offen.
# Anfassen: nur für ein geschlossenes Testnetz, nie im Betrieb.

#LF_ADMIN_PASSWORD=
# Vorgabe: leer. Hier gesetzt = gepinnt: weder Konsole noch `npm run setpw`
# können es danach ändern, und „Passwort vergessen" antwortet mit einem Hinweis
# auf diese Datei.
# Anfassen: wenn das Passwort aus einem Passwortspeicher des Betriebs kommt.

#LF_ADMIN_PASSWORD_HASH=
# Vorgabe: leer. Alternative zum Klartext: ein fertiger `scrypt$…`-Hash aus
# `npm run setpw`. Hat Vorrang vor LF_ADMIN_PASSWORD.
# Anfassen: wenn kein Klartext-Passwort in eine Datei geschrieben werden darf.

#LF_ADMIN_SESSION_HOURS=12
# Vorgabe: 12 Stunden, bis sich ein Browser neu anmelden muss (1–720).
# Anfassen: kürzer für einen öffentlich zugänglichen Bildschirm.

# Fehlversuchs-Sperre (admin.maxFailedLogins = 8 Versuche je IP,
# admin.lockoutMinutes = 10 Minuten Sperre) hat bewusst KEINE Umgebungsvariable
# und wird nur in der Konsole bzw. in config.json eingestellt — siehe docs/CONFIG.md.


# ═══ 4 · Laserforce-Log-Strom kommt HIER herein ════════════════════════════

#LF_TCP_HOST=0.0.0.0
# Vorgabe: 0.0.0.0 — die Anlage darf sich von jeder Adresse aus verbinden.
# Anfassen: auf die Adresse der Karte, an der die Anlage hängt, wenn der Rechner
# in mehreren Netzen steht.

#LF_TCP_PORT=9000
# Vorgabe: 9000. Hierhin richtest du den Log-Export der Laserforce-Anlage.
# Anfassen: wenn die Anlage einen anderen Port vorgibt. Wirkt im Betrieb (Neu-Bind).


# ═══ 5 · Wann gilt ein Match als beendet (docs/LASERFORCE.md) ══════════════
#
# Der Anlage wird nicht geglaubt, dass immer ein `0101` kommt — von Hand am
# Spielleiterplatz beendet, bleibt es manchmal aus. Jeder Wert in SEKUNDEN,
# 0 schaltet genau diesen Weg ab.

#LF_MATCH_END_WATCHDOG_SECONDS=120
# Vorgabe: 120 s. Kommt GAR KEINE Zeile mehr, gilt das Match danach als beendet
# (endReason: watchdog).
# Anfassen: höher, wenn eure Anlage in Pausen lange schweigt.

#LF_MATCH_END_STREAM_LOST_SECONDS=30
# Vorgabe: 30 s. TCP-Verbindung mitten im Match weg: so lange wird auf eine neue
# gewartet, danach endReason: stream_lost.
# Anfassen: höher in einem Netz, in dem die Verbindung öfter kurz abreißt.

#LF_MATCH_END_BLOCK_SECONDS=10
# Vorgabe: 10 s. Endabrechnung (Typ 6/7) gesehen und danach kein `0101`:
# so lange wird gewartet, dann ist Schluss.
# Anfassen: selten. 0 schaltet diese Erkennung aus, dann greift nur der Watchdog.

#LF_MATCH_DURATION_MS=720000
# Vorgabe: 720000 ms (12 min) — reiner Platzhalter, solange die Anlage keine
# Dauer gemeldet hat. Er wird NICHT als Countdown angezeigt: ohne gemeldete
# Dauer zählt die Uhr hoch (docs/GAMEMODES.md).
# Anfassen: fast nie; er beeinflusst keine Anzeige, nur den Vorbelegungswert.


# ═══ 6 · Match-Engine ══════════════════════════════════════════════════════

#LF_EMIT_UNKNOWN_EVENTS=true
# Vorgabe: true — für jeden Typ-4-Code, den der Parser nicht selbst auswertet,
# geht zusätzlich ein generisches `lf_event` raus.
# Anfassen: false, wenn ein angebundenes System an unbekannten Codes erstickt.


# ═══ 7 · Roher NDJSON-Strom geht HIER heraus ═══════════════════════════════
#
# Für Werkzeuge, die weder HTTP noch WebSocket sprechen. Sie verbinden sich
# hierher und bekommen dieselben Nachrichten wie /ws, eine JSON-Zeile je Stück.

#LF_STREAM_ENABLED=false
# Vorgabe: false — aus.
# Anfassen: wenn eine Steuerung oder ein Overlay einen nackten Socket braucht.

#LF_STREAM_HOST=127.0.0.1
# Vorgabe: 127.0.0.1 — nur dieser Rechner.
# Anfassen: 0.0.0.0 für Zugriff aus dem LAN. Dann unbedingt LF_API_TOKEN setzen:
# mit Token muss ein Client `{"token":"…"}` als erste Zeile senden.

#LF_STREAM_PORT=9100
# Vorgabe: 9100.
# Anfassen: bei Portkonflikt.


# ═══ 8 · Ausgänge (Webhook / TCP / UDP) ════════════════════════════════════
#
# Die Ausgänge selbst werden in der Konsole unter „Ausgänge" gepflegt
# (docs/INTEGRATION.md). Hier steht nur die Leine, an der sie hängen.

#LF_OUTPUT_ALLOW=
# Vorgabe: leer = jedes Ziel erlaubt. Komma-Liste erlaubter Ziele:
# `host`, `host:port`, `*.endung`, `*.endung:port`.
# Anfassen: auf einem gemeinsam genutzten Server — dann kann ein in der Konsole
# eingetragener Ausgang nicht mehr irgendwohin senden. Ein blockiertes Ziel wird
# mit einer Warnung übersprungen.


# ═══ 9 · MQTT → FunZone-Locationserver (docs/MQTT.md) ══════════════════════
#
# Schickt Rundenstart, Rundenende und den Missionsbericht an den lokalen Broker,
# an dem der Locationserver hängt. Standardmäßig AUS; ohne laufenden Broker
# startet lf_live trotzdem sofort und wertet den ganzen TDF-Strom aus.
#
# ACHTUNG, GEGENSEITE: der Locationserver leitet nur weiter, wenn dort
#   LF_PASSTHROUGH_EVENTS=*
# steht. Mit einer namentlichen Liste kommt wegen eines Fehlers in SEINEM Code
# nichts an — die beiden Auswege stehen in docs/MQTT.md.

#LF_MQTT_ENABLED=false
# Vorgabe: false.
# Anfassen: sobald die Anbindung an den Locationserver stehen soll.

#LF_MQTT_URL=mqtt://127.0.0.1:1883
# Vorgabe: der Broker auf demselben Rechner. Schemata: mqtt mqtts ws wss tcp tls.
# Anfassen: wenn der Broker woanders läuft.
# KEINE Zugangsdaten in die URL schreiben — dafür sind die beiden Zeilen ganz
# unten in diesem Abschnitt da (siehe Begründung dort).

#LF_MQTT_TOPIC=/decs/lfpassthrough
# Vorgabe: genau das Topic, das der Locationserver abonniert — wörtlich, ohne
# Platzhalter.
# Anfassen: nur nach Absprache mit der Gegenseite. Ändern TRENNT die Anbindung.

#LF_MQTT_TOPIC_SUFFIXES=false
# Vorgabe: false — alles geht auf das eine Topic und wird am Feld `event`
# unterschieden. true sendet auf <topic>/<event>.
# Anfassen: nur für einen EIGENEN Broker mit Platzhalter-Abonnement. Der
# Locationserver kann true NICHT empfangen.

#LF_MQTT_STATUS_TOPIC=
# Vorgabe: leer = dasselbe Topic wie die Daten. Eigenes Topic für die
# Online-Meldung und den Last Will.
# Anfassen: wenn Status und Daten getrennt abonniert werden sollen.

#LF_MQTT_QOS=1
# Vorgabe: 1 — passt zum Abonnement der Gegenseite. 0 | 1 | 2.
# Anfassen: selten.

#LF_MQTT_RETAIN=false
# Vorgabe: false. true lässt den Broker die letzte Nachricht aufbewahren.
# Anfassen: wenn ein später verbundener Abonnent den letzten Stand sehen soll.

#LF_MQTT_CLIENT_ID=
# Vorgabe: leer = lf-bridge-<rechnername>-<zufall>.
# Anfassen: wenn der Broker feste Client-IDs verlangt.

#LF_MQTT_RECONNECT_SECONDS=5
# Vorgabe: 5 s zwischen zwei Verbindungsversuchen (1–3600).
# Anfassen: höher, wenn der Broker regelmäßig länger weg ist.

#LF_MQTT_QUEUE_MAX=0
# Vorgabe: 0 = gar nichts puffern. Nachrichten im ARBEITSSPEICHER, solange der
# Broker weg ist (0–10000); bei Überlauf fällt die ÄLTESTE heraus und wird gezählt.
# Anfassen: nur in einer Installation ohne Missionsbericht — der hat eine
# Warteschlange auf der Platte und übersteht als einziger einen Neustart.

#LF_MQTT_TLS_INSECURE=false
# Vorgabe: false — ein Zertifikat muss gültig sein.
# Anfassen: nur für mqtts:// mit selbstsigniertem Zertifikat im eigenen Netz.

#LF_MQTT_MATCH_START=true
#LF_MQTT_MATCH_END=true
# Vorgabe: beide true — Rundenstart (mit der genauen Laufzeit) und Rundenende senden.
# Anfassen: false, wenn die Gegenseite nur eines von beidem will.

#LF_MQTT_STATUS=true
# Vorgabe: true — `bridge_online` beim Verbinden und `bridge_offline` als Last Will.
# Anfassen: false, wenn die Gegenseite an den Statusmeldungen stört.

#LF_MQTT_USERNAME=
#LF_MQTT_PASSWORD=
# Vorgabe: beide leer. ZUGANGSDATEN GEHÖREN AUSSCHLIESSLICH HIERHER.
# Sie haben mit Absicht KEIN Gegenstück in config.json: alles, was dort steht,
# wird in die Datei geschrieben UND von GET /api/config an die Konsole geliefert.
# Diese beiden Werte werden erst im Moment des Verbindungsaufbaus aus der
# Umgebung gelesen und nirgends zwischengespeichert; /api/status meldet nur
# `authConfigured: true|false`.
# Anfassen: wenn der Broker eine Anmeldung verlangt.


# ═══ 10 · Missionsbericht (docs/INTEGRATION.md, docs/STATS.md) ═════════════
#
# Die Kurzfassung eines beendeten Matches. Sie geht über die eingerichteten
# Ausgänge und über MQTT raus und liegt bis zur Zustellung in einer
# Warteschlange auf der Platte (data/reports/) — ein nicht erreichbares Ziel
# kostet keine Mission, auch über einen Neustart hinweg. WELCHE Kennzahlen
# darin stehen, entscheidet der Abschnitt `_bericht` der Profildatei unter
# modes/profile/ (docs/GAMEMODES.md).

#LF_REPORT_ENABLED=true
# Vorgabe: true. false erzeugt gar keinen Bericht mehr.
# Anfassen: wenn keine Gegenstelle ihn auswertet und die Warteschlange stört.

#LF_REPORT_NAMES=true
# Vorgabe: true — die Spielernamen stehen im Bericht.
# false lässt jeden Namen weg; die Spieler bleiben über ihre ID unterscheidbar.
# Anfassen: aus Datenschutzgründen, wenn der Bericht das Haus verlässt.
# Zusätzlich lässt sich dasselbe je Profil über `_bericht.namen` abschalten;
# es reicht, wenn EINES von beidem false sagt.


# ═══ 11 · Statistik → CSV-Dateien auf diesem PC (docs/STATS.md) ════════════
#
# Getrennt je Spielmodus-Familie (all_players_laserball.csv / _sm5.csv,
# totals_*), dazu matches.csv und player_modes.csv. Das passiert automatisch
# und hat keine eigene Einstellung.

#LF_CSV_ENABLED=true
# Vorgabe: true.
# Anfassen: false, wenn die Auswertung ausschließlich über die API läuft.

#LF_CSV_DIR=data/stats
# Vorgabe: data/stats, relativ zum Arbeitsverzeichnis.
# Anfassen: wenn die Dateien auf ein anderes Laufwerk sollen.

#LF_CSV_DELIMITER=;
# Vorgabe: ; — deutsches Excel. Erlaubt sind nur ; , und Tabulator.
# Anfassen: , für pandas/R.

#LF_CSV_BOM=true
# Vorgabe: true — Byte-Order-Mark, damit Excel die Umlaute richtig zeigt.
# Anfassen: false, wenn ein Werkzeug über dem BOM stolpert.

#LF_CSV_EVENTS=true
# Vorgabe: true — zusätzlich eine Ereignisdatei je Match (die größte Datei,
# rund 4 MB je 15-Minuten-Match bei 50 Spielern).
# Anfassen: false, wenn der Platz knapp ist.

#LF_CSV_LIVE=false
# Vorgabe: false — die Match-CSV entsteht am Ende des Matches.
# Anfassen: true, wenn eine Auswertung schon während des Matches mitlesen soll.
# Kostet einen Schreibvorgang je Änderung.


# ═══ 12 · Lesbare Ereignis-Logdatei (docs/LOGGING.md) ══════════════════════

#LF_EVENTLOG_ENABLED=true
# Vorgabe: true — eine lesbare Zeile je Ereignis nach data/logs/.
# Anfassen: false, wenn niemand sie liest (sie war einmal die größte Last-Quelle).

#LF_EVENTLOG_DIR=data/logs
# Vorgabe: data/logs, relativ zum Arbeitsverzeichnis.
# Anfassen: wenn die Dateien woanders hin sollen.

#LF_EVENTLOG_ROTATE=daily
# Vorgabe: daily → events-JJJJ-MM-TT.log.
# match → events-<matchId>.log (neue Datei je Match) · none → events.log.
# Anfassen: match, wenn einzelne Matches getrennt abgelegt werden sollen.

#LF_EVENTLOG_FLUSH_MS=250
# Vorgabe: 250 ms, die eine Zeile höchstens wartet, um sich EINEN Schreibvorgang
# mit den nächsten zu teilen (0–5000). Inhalt und Reihenfolge der Datei sind in
# jedem Fall identisch — nur die Zahl der Schreibaufrufe ändert sich
# (docs/PERFORMANCE.md).
# Anfassen: 0 schreibt jede Zeile sofort, kostet aber rund ein Drittel der
# gesamten CPU-Zeit des Dienstes.

# Der Dateinamens-Präfix (eventLog.filenamePrefix, Vorgabe `events`) hat bewusst
# KEINE Umgebungsvariable und steht nur in config.json — siehe docs/CONFIG.md.
# Änderungen an diesem ganzen Abschnitt wirken erst nach einem Neustart.


# ═══ 13 · Roh-Mitschnitt des TDF-Stroms (docs/CAPTURE.md) ══════════════════
#
# Schneidet den eingehenden Strom byteweise mit, eine Datei je Mission, damit
# ein Spiel später mit scripts/replay.js woanders nachgestellt werden kann.
# DIAGNOSE, KEIN DAUERBETRIEB: ein Mitschnitt enthält Spielernamen und die
# weltweit eindeutigen Laserforce-Mitglieds-IDs. Lässt sich auch in der Konsole
# ein- und ausschalten, ohne Neustart.

#LF_CAPTURE_ENABLED=false
# Vorgabe: false.
# Anfassen: nur für eine Testphase oder zur Fehlersuche, danach wieder aus.

#LF_CAPTURE_DIR=data/capture
# Vorgabe: data/capture.
# Anfassen: wenn die Mitschnitte auf ein anderes Laufwerk sollen.

#LF_CAPTURE_MAX_FILE_MB=20
# Vorgabe: 20 MB je Mission (1–2000); danach endet der Mitschnitt DIESER Mission,
# Auswertung und Strom laufen unberührt weiter.
# Anfassen: höher für sehr lange Missionen.

#LF_CAPTURE_MAX_FILES=50
# Vorgabe: 50 Dateien (1–1000); die ältesten werden gelöscht.
# Anfassen: höher, wenn mehr Historie gebraucht wird.

#LF_CAPTURE_MAX_TOTAL_MB=500
# Vorgabe: 500 MB für den ganzen Ordner (1–100000); die ältesten werden gelöscht.
# Anfassen: an den freien Platz anpassen — ein unbeaufsichtigter Hallen-PC darf
# sich nicht vollschreiben.


# ═══ 14 · Eigene Namensliste (optional) ════════════════════════════════════
#
# CSV mit `id,name,team` — überschreibt die Namen aus dem Strom.
# Format und Beispiel: docs/CONFIG.md.

#LF_LOCAL_ROSTER_ENABLED=false
# Vorgabe: false — es gelten die Namen aus dem Laserforce-Strom.
# Anfassen: wenn eigene Anzeigenamen gebraucht werden.

#LF_LOCAL_ROSTER_FILE=data/roster.csv
# Vorgabe: data/roster.csv. ACHTUNG: diese Zeile setzt `enabled` automatisch auf
# true — sie allein reicht zum Einschalten.
# Anfassen: wenn die Liste woanders liegt.


# ═══ 15 · „Auf welcher IP und welchem Port läuft die Kiste?" ═══════════════
#     (docs/NOTIFY.md)
#
# Geht einmal bei jedem Start raus und wenn sich die IP ändert, damit der
# Hallen-PC ohne Monitor auffindbar bleibt. Der ERSTE Start trägt zusätzlich das
# erzeugte Admin-Passwort; jeder weitere nur noch die Adresse. Derselbe Kanal
# liefert den Code für „Passwort vergessen".
#
# Es reicht EIN Kanal. Alles hier lässt sich auch in der Konsole unter
# „Einstellungen → Start-Benachrichtigung" einrichten — dann aber nicht
# zusätzlich hier setzen, sonst ist es gepinnt.

#LF_NOTIFY_ENABLED=true
# Vorgabe: true. false schaltet jede Benachrichtigung ab.
# Anfassen: wenn niemand sie bekommen soll.

#LF_NOTIFY_NAME=
# Vorgabe: leer = der Rechnername. Name dieser Installation in der Nachricht.
# Anfassen: wenn mehrere Hallen an denselben Kanal melden.

#LF_NOTIFY_ON_START=true
#LF_NOTIFY_ON_IP_CHANGE=true
# Vorgabe: beide true.
# Anfassen: false, wenn nur einer der beiden Anlässe melden soll.

#LF_NOTIFY_INCLUDE_INITIAL_PASSWORD=true
# Vorgabe: true — beim allerersten Start reist das erzeugte Admin-Passwort in
# der Nachricht mit. Auf einem PC ohne Monitor und ohne Shell ist das der
# einzige Weg, es je zu erfahren.
# Anfassen: false, wenn der Kanal nicht vertraulich genug ist; dann wird nur der
# Dateipfad genannt, unter dem es auf dem Rechner liegt.

# ── Kanal: ntfy — der einfachste, kein Konto nötig ──
#LF_NOTIFY_NTFY_TOPIC=
# Vorgabe: leer = ntfy aus. App installieren, dieses Topic abonnieren, fertig.
# Anfassen: ein schwer zu erratendes Topic wählen — wer es kennt, liest mit.
#LF_NOTIFY_NTFY_SERVER=https://ntfy.sh
# Vorgabe: der öffentliche Dienst.
# Anfassen: wenn ein eigener ntfy-Server läuft.
#LF_NOTIFY_NTFY_TOKEN=
# Vorgabe: leer.
# Anfassen: nur bei einem geschützten ntfy-Server.

# ── Kanal: Discord / Slack ──
#LF_NOTIFY_DISCORD_WEBHOOK=
# Vorgabe: leer. Kanal → Einstellungen → Integrationen → Webhooks → URL kopieren.
#LF_NOTIFY_SLACK_WEBHOOK=
# Vorgabe: leer. Slack „Incoming Webhook"-URL.

# ── Kanal: Telegram ──
#LF_NOTIFY_TELEGRAM_TOKEN=
# Vorgabe: leer. Token von @BotFather.
#LF_NOTIFY_TELEGRAM_CHAT_ID=
# Vorgabe: leer. Die Chat- oder Gruppen-ID. Beide Zeilen werden gebraucht.

# ── Kanal: eigener Webhook ──
#LF_NOTIFY_WEBHOOK_URL=
# Vorgabe: leer. Bekommt die ganze Meldung als JSON.
#LF_NOTIFY_WEBHOOK_SECRET=
# Vorgabe: leer. Gesetzt → HMAC-Signatur in X-LFB-Signature.

# ── Kanal: E-Mail ──
#LF_NOTIFY_EMAIL_TO=
# Vorgabe: leer = E-Mail aus. Empfänger, Komma-Liste möglich.
#LF_NOTIFY_SMTP_HOST=
# Vorgabe: leer. Der Postausgangsserver; ohne ihn wird nichts verschickt.
#LF_NOTIFY_SMTP_PORT=587
# Vorgabe: 587 (STARTTLS). 465 = sofortiges TLS, dann auch SECURE=true setzen.
#LF_NOTIFY_SMTP_SECURE=false
# Vorgabe: false. true für Port 465.
#LF_NOTIFY_SMTP_USER=
#LF_NOTIFY_SMTP_PASS=
# Vorgabe: beide leer. Ohne Benutzer wird gar nicht angemeldet.
# Anfassen: wie der Postfachanbieter es verlangt. Das Passwort steht besser hier
# als in config.json — in der Konsole erscheint es nur als „••••••".
#LF_NOTIFY_SMTP_FROM=
# Vorgabe: leer = der Benutzername, sonst lf-live@<rechnername>.
# Anfassen: wenn der Server eine bestimmte Absenderadresse verlangt.
#LF_NOTIFY_SMTP_TLS_INSECURE=false
# Vorgabe: false — das Zertifikat des Mailservers muss gültig sein.
# Anfassen: nur für einen eigenen Mailserver mit selbstsigniertem Zertifikat.
