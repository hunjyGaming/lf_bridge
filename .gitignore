node_modules/
.env
config.json
data/
# covers data/capture/ — raw stream recordings (docs/CAPTURE.md) carry player
# names and Laserforce member ids and must never reach a repository
*.tdf
*.log
*.tmp
inspect-report.json
.DS_Store

# modes/ is NOT ignored on purpose: the game-mode and display-profile JSON files
# ship with the project, and a measured mission number belongs in the repository
# (docs/GAMEMODES.md). Nothing in there is a secret or machine-specific.
!modes/
!modes/**

# graphify knowledge graph output
graphify-out/
